{
  "vectorsVersion": "0.2.0",
  "description": "agentPolicy decision vectors. A conformant gate reproduces every allow, reasonCode AND policyDigest below. Check order is normative and first match wins; a request that trips several rules is denied regardless of order, but the reasonCode it reports is not free. Matching is exact and case-sensitive. A caller jurisdiction is admissible only when VERIFIED; an unverified claim is discarded before any rule sees it, so it can never satisfy an allowlist.",
  "canonicalisation": "policyDigest = '<scheme>:<sha256 hex>' over the RFC 8785 (JCS) form of the policy object as it appears in each vector. An absent allowlist is null and an empty one is [] — they are different policies and digest differently. Caller-jurisdiction keys appear in the policy object ONLY when a rule exists, so a policy without them digests exactly as it did before the field was introduced.",
  "checkOrder": [
    "tool-not-allowed",
    "missing-caller-jurisdiction",
    "in-denied-jurisdiction",
    "not-in-allowed-jurisdictions",
    "missing-model-identity",
    "in-deniedModels",
    "in-deniedUseCases",
    "not-in-allowedModels",
    "missing-use-case-with-allowlist",
    "not-in-allowedUseCases"
  ],
  "reasonCodes": [
    "allowed",
    "tool-not-allowed",
    "missing-caller-jurisdiction",
    "in-denied-jurisdiction",
    "not-in-allowed-jurisdictions",
    "missing-model-identity",
    "in-deniedModels",
    "in-deniedUseCases",
    "not-in-allowedModels",
    "missing-use-case-with-allowlist",
    "not-in-allowedUseCases"
  ],
