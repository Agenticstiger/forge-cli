# Overrides for requirements/ci-security.txt. scripts/ci/compile_requirements.sh
# passes this file to uv pip compile as --override, and the Security Scan job
# installs the lock with --no-deps so pip does not re-check the pins it replaces.
# The extension is not .txt or .in on purpose, so Dependabot leaves it alone.
#
# semgrep pins mcp exactly (mcp==1.29.0 in 1.186.0 and 1.187.0). Every mcp
# release before 1.30.0 carries GHSA-qx49-fqc8-xw99 (high) and four moderate
# advisories. The job only runs `semgrep scan` with a local rule file, which
# does not touch mcp, so the lock takes the first fixed 1.x release instead.
# Remove the line once semgrep itself pins mcp>=1.30.0.
mcp==1.30.0
#
# semgrep also pins the OpenTelemetry family (~=1.37.0 and ~=0.58b0) and wcmatch
# (~=8.3). The releases it allows carry GHSA-mf5v-w3w3-f6cg and GHSA-xcq7-p3pf-p88h
# (opentelemetry-api) and GHSA-53pm-wgxf-c6qf (wcmatch). `semgrep scan` with a
# local rule file runs none of that code, and its output is identical on the
# fixed releases, so the lock takes them. Remove each line once semgrep itself
# pins a fixed release.
opentelemetry-api==1.45.2
opentelemetry-sdk==1.45.2
opentelemetry-exporter-otlp-proto-http==1.45.2
opentelemetry-instrumentation-requests==0.66b2
opentelemetry-instrumentation-threading==0.66b2
wcmatch==12.0.4
